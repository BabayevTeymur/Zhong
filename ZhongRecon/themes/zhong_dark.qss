* {
    font-family: "Segoe UI", "Inter", sans-serif;
    color: #f0e8ff;
}

QMainWindow, QWidget {
    background-color: #0a0614;
}

QMenuBar, QMenu {
    background-color: #130a21;
    color: #e6dcff;
}

QMenu::item:selected {
    background: #2b1844;
}

QTabWidget::pane {
    border: 1px solid #3f1c5a;
    background: #0d0817;
}

QTabBar::tab {
    background: #140a22;
    border: 1px solid #2b1844;
    padding: 8px 14px;
    margin-right: 2px;
    color: #e6dcff;
}

QTabBar::tab:selected {
    background: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 #2c1640, stop:1 #1d0f2d);
    border-color: #c598ff;
}

QLabel#scanInfo {
    color: #d7c7ff;
    font-weight: 600;
}

QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QComboBox {
    background: #120a1f;
    border: 1px solid #3f1c5a;
    padding: 6px;
    border-radius: 6px;
    selection-background-color: #4c2a6d;
    selection-color: #f0e8ff;
}

QCheckBox, QRadioButton {
    spacing: 6px;
}

QCheckBox::indicator, QRadioButton::indicator {
    border: 1px solid #3f1c5a;
    background: #0f081a;
    width: 14px;
    height: 14px;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background: #c598ff;
    border-color: #c598ff;
}

QPushButton {
    background: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 #2b1844, stop:1 #1d0f2d);
    border: 1px solid #3f1c5a;
    color: #f0e8ff;
    padding: 8px 14px;
    border-radius: 8px;
}

QPushButton:hover {
    background: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 #3a1f55, stop:1 #29143f);
}

QPushButton:pressed {
    background: #1d0f2d;
}

QPushButton:disabled {
    background: #1a1028;
    color: #6c5f88;
    border-color: #2b1844;
}

QTableWidget {
    background: #0f081a;
    alternate-background-color: #180d2b;
    gridline-color: #2b1844;
    selection-background-color: #4c2a6d;
    selection-color: #f7efff;
}

QHeaderView::section {
    background: #1d0f2d;
    border: 1px solid #2b1844;
    padding: 6px;
    color: #e6dcff;
}

QScrollBar:vertical {
    background: #0f081a;
    width: 12px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #2b1844;
    min-height: 20px;
    border-radius: 6px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QProgressBar {
    border: 1px solid #3f1c5a;
    border-radius: 8px;
    background: #0f081a;
    text-align: center;
    color: #f0e8ff;
}

QProgressBar::chunk {
    background: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 #c598ff, stop:1 #8d5fd3);
    border-radius: 8px;
}
